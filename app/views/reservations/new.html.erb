<main class="sec sec-white">
  <span class="sec-lbl">Dernière étape</span>
  <h1 class="sec-h2 reservation-title">Réserver ma commande</h1>

  <%= form_with model: @reservation, local: true, class: "reservation-form" do |form| %>
    <% if @reservation.errors.any? %>
      <div class="form-errors"><%= @reservation.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="f-block">
      <%= form.label :pickup_time, "Heure de retrait" %>
      <div class="pickup-fields">
        <%= form.date_field :pickup_date,
          value: @reservation.pickup_time&.to_date || Date.current,
          class: "f-input pickup-input pickup-date",
          required: true,
          min: Date.current %>
        <%= form.select :pickup_hour,
          options_for_select(
            (7...19).flat_map { |hour| ["%02d:00" % hour, "%02d:30" % hour] } + ["19:00"],
            @reservation.pickup_time&.strftime("%H:%M")
          ),
          { prompt: "Choisir une heure" },
          class: "f-input pickup-input",
          required: true %>
      </div>
    </div>

    <div class="f-block">
      <%= form.label :payment_method, "Mode de paiement" %>
      <%= form.select :payment_method, [["Paiement en boutique", "pay_at_store"], ["Paiement en ligne", "stripe"]], {}, class: "f-input" %>
    </div>

    <div class="f-block">
      <%= form.label :comment, "Commentaire" %>
      <%= form.text_area :comment, rows: 2, class: "f-input" %>
    </div>

    <div class="form-actions">
      <!-- Bouton pour paiement en boutique (vide le panier) -->
      <%= form.submit "Confirmer et payer en boutique", class: "btn-orange", name: "payment_action", value: "pay_at_store" %>
      
      <!-- Bouton pour Stripe (ne vide PAS le panier) -->
      <%= form.submit "Payer en ligne avec Stripe", class: "btn-orange", name: "payment_action", value: "stripe", data: { turbo: false } %>
    </div>
      <% end %>
</main>